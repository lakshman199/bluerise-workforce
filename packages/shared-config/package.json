{
  "name": "@bluerise/shared-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript, lint, and runtime configuration for the BlueRise Workforce monorepo.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "files": [
    "dist",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
