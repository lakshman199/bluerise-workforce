##
## BlueRise Workforce — environment template
##
## Copy to .env and fill in. Never commit a filled-in .env; .gitignore already excludes it.
## No value in this file is a real secret and none should ever become one.
##

# ---------------------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------------------
# one of: development | test | staging | production
APP_ENV=development
APP_NAME=bluerise-api
APP_VERSION=0.1.0

# ---------------------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------------------
API_PORT=4300
API_HOST=0.0.0.0

# Where the web application is served from. Used for links generated by the API.
FRONTEND_URL=http://localhost:4310

# Comma-separated CORS allowlist. A wildcard is rejected outright in staging and production.
CORS_ALLOWED_ORIGINS=http://localhost:4310,http://127.0.0.1:4310

# ---------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------
DATABASE_URL=postgresql://bluerise:bluerise_dev_password@localhost:5432/bluerise_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_LOG_QUERIES=false

# ---------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable output. Forced off in staging and production, where logs must stay JSON.
LOG_PRETTY=true

# ---------------------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------------------------------
# API documentation
# ---------------------------------------------------------------------------------------
# Forced off in staging and production regardless of this value.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------------------
# Web application build-time configuration
# ---------------------------------------------------------------------------------------
WEB_PORT=4310
WEB_API_BASE_URL=http://localhost:4300/api/v1

# ---------------------------------------------------------------------------------------
# Phase 3 — authentication. Not yet read by any code.
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------------------
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------------------
# Phase 6 — provider integrations. Not yet read by any code.
#
# No credentials have been supplied for any of these, so no adapter exists yet. Leaving a
# variable empty is correct; it does not silently enable a mock. See
# docs/integrations/README.md.
# ---------------------------------------------------------------------------------------
# GUSTO_CLIENT_ID=
# GUSTO_CLIENT_SECRET=
# GUSTO_WEBHOOK_SECRET=
# ADP_CLIENT_ID=
# ADP_CLIENT_SECRET=
# BENEFITS_PROVIDER_KEY=
# BENEFITS_PROVIDER_API_KEY=
# TIMEKEEPING_PROVIDER_KEY=
# TIMEKEEPING_PROVIDER_API_KEY=
# WORKERS_COMP_PROVIDER_KEY=
# WORKERS_COMP_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------------------
# Phase 2 — contact form delivery and abuse prevention. Not yet read by any code.
#
# Until a mail provider is configured the contact form persists and does not send email.
# Until a CAPTCHA provider is configured the endpoint relies on rate limiting only; no
# fake CAPTCHA is presented.
# ---------------------------------------------------------------------------------------
# MAIL_PROVIDER=
# MAIL_API_KEY=
# MAIL_FROM_ADDRESS=
# CAPTCHA_PROVIDER=
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
